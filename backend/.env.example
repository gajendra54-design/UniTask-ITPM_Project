PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unitask
JWT_SECRET=replace-with-a-long-random-secret

# Required by the resource storage client at startup.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Enables AI features.
GROQ_API_KEY=

# Email: configure SendGrid or SMTP for password resets and reports.
SENDGRID_API_KEY=
EMAIL_FROM=
NAME_FROM=UniTask
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
